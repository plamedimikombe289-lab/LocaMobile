<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- En-tête avec boutons de navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="LocaMobile"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/boutonConnexion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connexion"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/boutonAjouter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+" />
    </LinearLayout>

    <!-- Barre de recherche par ville -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <EditText
            android:id="@+id/champVille"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Ville (vide = toutes)"
            android:inputType="text" />

        <Button
            android:id="@+id/boutonChercher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chercher" />
    </LinearLayout>

    <!-- Zone de message d'erreur/statut -->
    <TextView
        android:id="@+id/messageErreur"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#D32F2F"
        android:textSize="15sp"
        android:padding="8dp"
        android:visibility="gone" />

    <!-- Liste dynamique des logements -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/conteneurLogements"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</LinearLayout>
