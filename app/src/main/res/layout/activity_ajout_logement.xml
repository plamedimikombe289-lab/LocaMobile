<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Publier un logement"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/champTitre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Titre du logement"
        android:inputType="text"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/champVille"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ville"
        android:inputType="text"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/champPrix"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Prix par nuit ($)"
        android:inputType="numberDecimal"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/champVoyageurs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombre de voyageurs"
        android:inputType="number"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/boutonPublier"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Publier le logement"
        android:padding="12dp" />

    <TextView
        android:id="@+id/resultatAjout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:layout_marginTop="24dp" />

</LinearLayout>
